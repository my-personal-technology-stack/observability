                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "sum by (name) (rate(container_network_receive_bytes_total{name!=\"\"}[5m]))",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 4,
            "title": "Network transmitted by container",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 9
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "min": 0,
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 15,
                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name!=\"\"}[5m]))",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ]
        }
    ],
    "links": [],
    "liveNow": false
}